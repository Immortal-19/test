<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact - My Minimalist Blog</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800">
  <header class="border-b">
    <nav class="max-w-5xl mx-auto flex justify-between items-center p-4">
      <a href="index.html" class="text-xl font-bold">My Blog</a>
      <div class="space-x-4">
        <a href="index.html">Home</a>
        <a href="blog.html">Blog</a>
        <a href="about.html">About</a>
        <a href="contact.html">Contact</a>
      </div>
    </nav>
  </header>
  <main class="max-w-5xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-4">Contact</h1>
    <form action="https://formspree.io/f/yourformid" method="POST" class="space-y-4">
      <input type="text" name="name" placeholder="Your Name" class="w-full border p-2 rounded" required>
      <input type="email" name="email" placeholder="Your Email" class="w-full border p-2 rounded" required>
      <textarea name="message" placeholder="Your Message" class="w-full border p-2 rounded" rows="5" required></textarea>
      <button type="submit" class="px-4 py-2 bg-black text-white rounded">Send</button>
    </form>
  </main>
</body>
</html>

